{
  "name": "@tode-sdk/figma-angular",
  "version": "1.0.0",
  "description": "Tode Analytics SDK for Figma plugins built with Angular",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --external @angular/core --external rxjs",
    "typecheck": "tsc --noEmit",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch --external @angular/core --external rxjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@tode-sdk/core": "^1.0.0"
  },
  "peerDependencies": {
    "@angular/core": ">=14.0.0",
    "rxjs": ">=7.0.0"
  },
  "devDependencies": {
    "@angular/core": "^22.2.3",
    "jsdom": "^25.0.1",
    "rxjs": "^7.8.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "tode",
    "analytics",
    "figma",
    "plugin",
    "angular",
    "service"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kolebayev/tode-sdk.git",
    "directory": "packages/figma-angular"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": "https://docs.usetode.dev",
  "bugs": {
    "url": "https://github.com/kolebayev/tode-sdk/issues"
  }
}
