{
  "name": "@tode-sdk/figma-vue",
  "version": "1.0.0",
  "description": "Tode Analytics SDK for Figma plugins built with Vue",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --external vue",
    "typecheck": "tsc --noEmit",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch --external vue"
  },
  "dependencies": {
    "@tode-sdk/core": "^1.0.0"
  },
  "peerDependencies": {
    "vue": ">=3.0.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vue": "^3.5.13"
  },
  "keywords": [
    "tode",
    "analytics",
    "figma",
    "plugin",
    "vue",
    "composable"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tode-analytics/tode-plugin-tracker-lib.git",
    "directory": "packages/figma-vue"
  },
  "license": "MIT"
}
